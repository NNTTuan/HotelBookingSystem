classDiagram
    direction TB
    class Main {
        +main(String[] args) void
    }
    class QuanLyKhachSan {
        -String DATA_DIR
        -String FILE_PHONG
        -String FILE_PHIEU
        -List~PhongKhachSan~ danhSachPhong
        -List~PhieuDatPhong~ danhSachPhieu
        +getDanhSachPhong() List
        +getDanhSachPhieu() List
        -khoiTao20Phong() List
        +docFilePhong() List
        +luuFilePhong(List) void
        +docFilePhieu() List
        +luuFilePhieu() void
        +timPhieuDangHoatDong(int) PhieuDatPhong
        +timPhieuDangHoatDongTheoCCCD(String) PhieuDatPhong
        +checkIn(int, KhachHang, int) boolean
        +checkOut(int, int) boolean
        +xacNhanDonXong(int) boolean
        +timPhong(int) PhongKhachSan
    }
    class KhachHangValidator {
        -KhachHangValidator()
        +kiemTraHoTen(String) void
        +kiemTraCCCD(String) void
        +kiemTraSoDienThoai(String) void
        +kiemTraSoNgayThue(int) void
        +kiemTraThongTinCheckIn(KhachHang, int) void
    }
    class PhongKhachSan {
        <<abstract>>
        +THUE_VAT double = 0.1
        +tongSoLuongPhong int
        #soPhong int
        #tang int
        #loaiPhong String
        #trangThai String
        #giaCoBan double
        +getSoPhong() int
        +getTang() int
        +getLoaiPhong() String
        +getTrangThai() String
        +setTrangThai(String) void
        +getGiaCoBan() double
        +tinhTienGoc(int) double
        +tinhPhiDichVu(int) double
        +tinhTienGiamGia(int) double
        +tinhTienTruocThue(int) double
        +tinhTienThueVAT(int) double
        +tinhTienThue(int) double
    }
    class PhongStandard {
        +GIA_MAC_DINH double = 500000
        +tinhTienThue(int) double
    }
    class PhongVIP {
        +GIA_MAC_DINH double = 1200000
        +getPhiDichVu() double
        +tinhPhiDichVu() double
        +getTiLeGiamGia() double
        +tinhTienGiamGia(double) double
        +tinhTienThue(int) double
    }
    class PhongPenthouse {
        +GIA_MAC_DINH double = 2500000
        +getPhiDichVu() double
        +tinhPhiDichVu() double
        +getTiLeGiamGia() double
        +tinhTienGiamGia(double) double
        +tinhTienThue(int) double
    }
    class IDiscountable {
        <<interface>>
        +getTiLeGiamGia() double
        +tinhTienGiamGia(double) double
    }
    class IServiceChargable {
        <<interface>>
        +getPhiDichVu() double
        +tinhPhiDichVu() double
    }
    class KhachHang {
        -hoTen String
        -soCCCD String
        -soDienThoai String
        -anhKhuonMatPath String
        +getHoTen() String
        +getSoCCCD() String
        +getSoDienThoai() String
        +getAnhKhuonMatPath() String
    }
    class PhieuDatPhong {
        -maPhieu String
        -phong PhongKhachSan
        -khachHang KhachHang
        -soNgayThue int
        -trangThai String
        +tinhTongTienPhieu() double
        +getMaPhieu() String
        +getPhong() PhongKhachSan
        +getKhachHang() KhachHang
        +getSoNgayThue() int
        +getTrangThai() String
    }
    class MainFrame
    class ConsoleView
    class QuanLyPhongPanel
    class CheckInPanel
    class CheckOutPanel
    class ThongKePanel
    class BieuDoDoanhThuPanel
    class BieuDoDoanhThuTheoLoaiPanel
    class PhongConsoleHandler
    class CheckInConsoleHandler
    class CheckOutConsoleHandler
    PhongKhachSan <|-- PhongStandard
    PhongKhachSan <|-- PhongVIP
    PhongKhachSan <|-- PhongPenthouse
    IDiscountable <|.. PhongVIP
    IServiceChargable <|.. PhongVIP
    IDiscountable <|.. PhongPenthouse
    IServiceChargable <|.. PhongPenthouse
QuanLyKhachSan "1" o-- "0..*" PhongKhachSan : quan ly
QuanLyKhachSan "1" o-- "0..*" PhieuDatPhong : quan ly
