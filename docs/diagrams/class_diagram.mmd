classDiagram
    namespace Model {
        class PhongKhachSan {
            <<abstract>>
            #int soPhong
            #int tang
            #String loaiPhong
            #String trangThai
            #double giaCoBan
            +tinhTienGoc(int soNgay) double
            +tinhPhiDichVu(int soNgay) double
            +tinhTienGiamGia(int soNgay) double
            +tinhTienTruocThue(int soNgay) double
            +tinhTienThueVAT(int soNgay) double
            +tinhTienThue(int soNgay) double
            +getSoPhong() int
            +getTrangThai() String
            +setTrangThai(String trangThai) void
        }
        class PhongStandard {
            +tinhTienThue(int soNgay) double
        }
        class PhongVIP {
            +getPhiDichVu() double
            +getTiLeGiamGia() double
            +tinhTienGiamGia(double tongTienGoc) double
            +tinhTienThue(int soNgay) double
        }
        class PhongPenthouse {
            +getPhiDichVu() double
            +getTiLeGiamGia() double
            +tinhTienGiamGia(double tongTienGoc) double
            +tinhTienThue(int soNgay) double
        }
        class IDiscountable {
            <<interface>>
            +getTiLeGiamGia() double
            +tinhTienGiamGia(double tongTienGoc) double
        }
        class IServiceChargable {
            <<interface>>
            +getPhiDichVu() double
            +tinhPhiDichVu() double
        }
        class KhachHang {
            -String hoTen
            -String soCCCD
            -String soDienThoai
            -String anhKhuonMatPath
            +getHoTen() String
            +getSoCCCD() String
            +getSoDienThoai() String
            +getAnhKhuonMatPath() String
        }
        class PhieuDatPhong {
            -String maPhieu
            -PhongKhachSan phong
            -KhachHang khachHang
            -int soNgayThue
            -String trangThai
            +getKhachHang() KhachHang
            +getPhong() PhongKhachSan
            +getTrangThai() String
        }
    }

    namespace Service {
        class QuanLyKhachSan {
            -List~PhongKhachSan~ danhSachPhong
            -List~PhieuDatPhong~ danhSachPhieu
            +docFilePhong() List~PhongKhachSan~
            +luuFilePhong(List~PhongKhachSan~ ds) void
            +docFilePhieu() List~PhieuDatPhong~
            +luuFilePhieu() void
            +timPhong(int soPhong) PhongKhachSan
            +timPhieuDangHoatDongTheoCCCD(String soCCCD) PhieuDatPhong
            +checkIn(int soPhong, KhachHang khach) boolean
            +checkOut(int soPhong, int soNgayThucTe) boolean
            +xacNhanDonXong(int soPhong) boolean
        }
    }

    namespace View {
        class MainFrame {
            -QuanLyKhachSan quanLyKhachSan
        }
        class QuanLyPhongPanel {
            -QuanLyKhachSan quanLyKhachSan
            +capNhatSoDoPhong() void
        }
        class CheckInPanel {
            -QuanLyKhachSan quanLyKhachSan
            +xuLyCheckIn() void
        }
        class CheckOutPanel {
            -QuanLyKhachSan quanLyKhachSan
            -PhieuDatPhong phieuHienTai
            +xuLyTimKiem() void
            +capNhatTongTien() void
            +xuLyThanhToan() void
            +xuLyInHoaDon() void
        }
        class CameraPreviewDialog {
            -Webcam webcam
            +xuLyChupAnh() void
        }
    }

    PhongKhachSan <|-- PhongStandard
    PhongKhachSan <|-- PhongVIP
    PhongKhachSan <|-- PhongPenthouse
    IDiscountable <|.. PhongVIP
    IDiscountable <|.. PhongPenthouse
    IServiceChargable <|.. PhongVIP
    IServiceChargable <|.. PhongPenthouse

    PhieuDatPhong "1" --> "1" KhachHang
    PhieuDatPhong "1" --> "1" PhongKhachSan
    QuanLyKhachSan "1" *-- "*" PhongKhachSan
    QuanLyKhachSan "1" *-- "*" PhieuDatPhong

    MainFrame --> QuanLyKhachSan
    QuanLyPhongPanel --> QuanLyKhachSan
    CheckInPanel --> QuanLyKhachSan
    CheckInPanel ..> CameraPreviewDialog
    CheckOutPanel --> QuanLyKhachSan